+enum class MirrorScale { FIT, FILL, STRETCH }
+
+// scale modes for screen mirroring: FIT keeps the whole frame (black bars), FILL covers the screen cropping at most
+// MAX_FILL_CROP of the frame, STRETCH distorts to the screen. content gets the size modifier for its surface
+@Composable
+fun MirrorFrame(
+    aspect: Float,
+    mode: MirrorScale,
+    modifier: Modifier = Modifier,
+    content: @Composable (Modifier) -> Unit,
+) {
+    BoxWithConstraints(modifier = modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+        val w = maxWidth
+        val h = maxHeight
+        val boxAspect = w / h
+        val wide = aspect > boxAspect
+        val fit = if (wide) Modifier.requiredSize(w, w / aspect) else Modifier.requiredSize(h * aspect, h)
+        val sizeModifier = when (mode) {
+            MirrorScale.FIT -> fit
+            MirrorScale.STRETCH -> Modifier.requiredSize(w, h)
+            MirrorScale.FILL -> {
+                val ratio = (if (wide) aspect / boxAspect else boxAspect / aspect).coerceIn(1f, MAX_FILL_CROP)
+                if (wide) Modifier.requiredSize(w * ratio, (w / aspect) * ratio)
+                else Modifier.requiredSize((h * aspect) * ratio, h * ratio)
+            }
+        }
+        content(sizeModifier)
+    }
+}
+
+private const val MAX_FILL_CROP = 1.35f
+
